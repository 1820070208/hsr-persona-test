  "questions": [
    {
      "id": "Q25",
      "kind": "likert",
      "axis": "EI",
      "pole": "E",
      "text": "我经常是那个在饭桌上抛出新话题的人。",
      "intent": "话题发起",
      "note": "测的是群体中主动供给话题的习惯，不是口才。"
    },
    {
      "id": "Q26",
      "kind": "likert",
      "axis": "EI",
      "pole": "I",
      "text": "我一个人待很久也不觉得闷，反而挺自在。",
      "intent": "独处自在",
      "note": "与Q02互补：Q02测社交后的回血需求，本题测独处的基线舒适度。"
    },
    {
      "id": "Q27",
      "kind": "likert",
      "axis": "EI",
      "pole": "I",
      "text": "我心情低落时，更想一个人静静待着。",
      "intent": "低落去向",
      "note": "测低落时的回血方向（找人还是独处），不涉及情绪强弱。"
    },
    {
      "id": "Q28",
      "kind": "likert",
      "axis": "TF",
      "pole": "T",
      "text": "我面对好朋友的失误，也会忍不住直接指出来。",
      "intent": "熟人直言",
      "note": "直言的舒适度，不是是否得罪人。"
    },
    {
      "id": "Q29",
      "kind": "likert",
      "axis": "TF",
      "pole": "F",
      "text": "我给别人提意见时，总会先说好听的再提不足。",
      "intent": "委婉表达",
      "note": ""
    },
    {
      "id": "Q30",
      "kind": "likert",
      "axis": "TF",
      "pole": "F",
      "text": "我发现有分歧时，最先担心的是关系会不会受伤。",
      "intent": "关系优先",
      "note": "与情景题Q22的F选项呼应，但这里是日常分歧场景。"
    },
    {
      "id": "Q31",
      "kind": "likert",
      "axis": "JP",
      "pole": "J",
      "text": "我有没做完的事，就总觉得心里挂着放不下。",
      "intent": "事情收尾",
      "note": ""
    },
    {
      "id": "Q32",
      "kind": "likert",
      "axis": "JP",
      "pole": "P",
      "text": "我喜欢同时开好几个坑，哪个来劲就先做哪个。",
      "intent": "同时开坑",
      "note": "「开坑」为口语用词，可按目标人群替换为「开始几个新项目」。"
    },
    {
      "id": "Q33",
      "kind": "likert",
      "axis": "JP",
      "pole": "P",
      "text": "我经常心血来潮，给平淡的日子加点新花样。",
      "intent": "日常花样",
      "note": ""
    },
    {
      "id": "Q34",
      "kind": "likert",
      "axis": "SN",
      "pole": "S",
      "text": "我吃饭时很在意口感和味道这些具体的体验。",
      "intent": "五感体验",
      "note": ""
    },
    {
      "id": "Q35",
      "kind": "likert",
      "axis": "SN",
      "pole": "N",
      "text": "我说话时特别爱打比方，把事情讲成画面。",
      "intent": "爱打比方",
      "note": "隐喻和类比是N极的经典外显行为。"
    },
    {
      "id": "Q36",
      "kind": "likert",
      "axis": "SN",
      "pole": "N",
      "text": "我常常琢磨若干年后的生活可能是什么样子。",
      "intent": "未来畅想",
      "note": ""
    }
  ]
